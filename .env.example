# 高德 Web 服务 API（后端 POI 搜索 + 驾车路径规划）— 必填
AMAP_API_KEY=

# 高德 Web 端 JS API（前端地图渲染）— 必填
AMAP_JS_KEY=
AMAP_JS_SECURITY_CODE=

# LLM API（DeepSeek / OpenAI）— 必填
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash-vision-exp

# 数据库连接 — Docker 部署用 postgres（容器名），本地开发改为 localhost
DATABASE_URL=postgresql+asyncpg://travelpal:travelpal123@postgres:5432/travelpal

# Celery 消息代理 — Docker 部署用 lavinmq（容器名），本地开发改为 localhost：
#   本地直跑 worker(非 docker) 时用 amqp://guest:guest@localhost:5672//
#   Docker 部署由 docker-compose 固定注入 amqp://guest:guest@lavinmq:5672//（覆盖本值）
CELERY_BROKER_URL=amqp://guest:guest@lavinmq:5672//

# Prometheus 指标共享目录 — backend 与 celery worker 必须指向同一目录
# 本地开发默认 /tmp/travelpal_metrics 即可；Docker 部署由 docker-compose 挂载共享卷
PROMETHEUS_MULTIPROC_DIR=/tmp/travelpal_metrics

# Prometheus 抓取 /api/metrics 的 Basic Auth 密码（nginx .htpasswd 中 metrics 用户）
# 值须与服务器 /etc/nginx/.htpasswd 的 metrics 密码一致；部署时在服务器 .env 填写
PROMETHEUS_BASIC_PASS=

# Grafana 管理员密码：首次部署即预置为安全值（避开默认 admin/admin）
# 用户固定 admin，密码建议 >=8 位、含字母数字；部署时在服务器 .env 填写
GF_SECURITY_ADMIN_PASSWORD=
