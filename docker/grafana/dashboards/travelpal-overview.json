{
  "title": "TravelPal 概览",
  "uid": "travelpal-overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "title": "LLM token 消耗（按方向）",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (direction) (travelpal_llm_tokens_total)",
          "legendFormat": "{{direction}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "异步任务执行耗时（按类型）",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.9, sum by (le, task_type) (rate(travelpal_task_duration_seconds_bucket[5m])))",
          "legendFormat": "p90 {{task_type}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "HTTP 请求数（按状态码）",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum by (status) (rate(travelpal_http_requests_total[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "驾车 API 调用（按结果）",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum by (result) (rate(travelpal_driving_calls_total[5m]))",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "任务完成数（按类型×状态）",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum by (task_type, status) (travelpal_task_total)",
          "legendFormat": "{{task_type}}/{{status}}"
        }
      ],
      "options": {
        "reduceOptions": { "values": false, "calcs": ["last"] },
        "orientation": "auto"
      }
    }
  ],
  "timepicker": {}
}
